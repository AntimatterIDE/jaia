# React Bits Pro license key.
# Only needed to pull new components from the @reactbits-starter / @reactbits-pro
# registries via `npx shadcn@latest add`. Not read at build or runtime — already
# installed components are plain source files in this repo.
# Copy this file to .env.local and fill in the value.
REACTBITS_LICENSE_KEY=

# OpenRouter — required for the on-site sales chat (`/api/chat`).
# Without it the widget stays visible but tells visitors to use /contact.
OPENROUTER_API_KEY=

# Optional. Defaults to GPT-5.6 Luna Pro.
# OPENROUTER_MODEL=openai/gpt-5.6-luna-pro
